{
  "name": "nova-companion",
  "version": "0.7.2",
  "description": "A playful desktop fox companion with Codex activity, personality, and optional spoken quips.",
  "main": "src/main.cjs",
  "type": "commonjs",
  "private": true,
  "license": "MIT",
  "author": "Codex Avatars contributors",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "start:background": "electron . --background",
    "dev": "electron . --dev",
    "test": "node --test",
    "demo": "node scripts/send-demo-event.mjs",
    "preview": "electron . --capture=artifacts/preview.png",
    "preview:settings": "electron . --capture-settings=artifacts/settings.png",
    "setup": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "icon:render": "electron scripts/render-icon.cjs",
    "hooks:install": "node scripts/manage-hooks.mjs install",
    "hooks:status": "node scripts/manage-hooks.mjs status",
    "hooks:uninstall": "node scripts/manage-hooks.mjs uninstall",
    "dist": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "dev.novacompanion.desktop",
    "productName": "Nova Companion",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "extraResources": [
      { "from": "scripts/codex-hook.ps1", "to": "hooks/codex-hook.ps1" },
      { "from": ".agents", "to": "integration/.agents" },
      { "from": "plugins", "to": "integration/plugins" }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
